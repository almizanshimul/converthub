# Copy this file to .env and fill in real values. Never commit .env.

# MariaDB/MySQL connection string used by @prisma/adapter-mariadb.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/converthub"

# NextAuth (Auth.js v5)
AUTH_SECRET="generate-a-random-32+-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# Credentials for the single seeded admin user (see prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# https://www.exchangerate-api.com/ — used by scripts/fetch-currency-rates.ts
EXCHANGERATE_API_KEY=""

# Shown in the site footer/contact page
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"

# Canonical origin (no trailing slash) — used in sitemap.xml, robots.txt, and
# JSON-LD structured data. Defaults to http://localhost:3000 if unset, so this
# MUST be set to the real domain in production or search engines will be
# pointed at localhost.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Set to "true" once a real ad network (e.g. AdSense) is wired up — ad slots
# render nothing until then. See src/components/ads/ad-slot.tsx.
NEXT_PUBLIC_ADS_ENABLED="false"

# Your AdSense publisher ID (looks like "ca-pub-XXXXXXXXXXXXXXXX"), from your
# AdSense account. Leave unset to keep ad-slot.tsx rendering only the
# placeholder. Loading is gated on visitor consent (see src/lib/consent.ts).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Optional third-party tracking — all off unless the matching ID is set, and
# all gated on visitor consent via Google Consent Mode v2 / Clarity's consent
# API (see src/components/consent/tracking-scripts.tsx). None of these are
# required for the site to run.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Optional — defaults to http://localhost:5000, only needed for the
# translate:missing / translate:ui scripts (see README's Localization section)
LIBRETRANSLATE_URL="http://localhost:5000"
