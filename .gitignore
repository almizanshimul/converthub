# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# scheduled-task logs (see scripts/run-currency-fetch.bat)
/logs/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# run-convert skill driver (own deps + generated screenshots, not the app's)
/.claude/skills/run-convert/node_modules
/.claude/skills/run-convert/screenshots

# local session runtime state, not project content
/.claude/scheduled_tasks.lock
